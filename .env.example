# ══════════════════════════════════════════════════════════════
# Bitcoin trading configuration.
#
# Copy this file to .env and fill in your own values.
# Include the leading dot in the filename.
# ══════════════════════════════════════════════════════════════


# --- Upbit API credentials ---
# Create credentials in the account's Open API settings.
# Enable account inquiry and orders; do not enable withdrawals.
# Register the IP address used by this machine.
# Check credential expiry and replace expired credentials before resuming.

UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=


# --- Live-order switch ---
# 1 = dry run: inspect signals without placing orders; use this for setup.
# 0 = live trading with real funds.

DRY_RUN=1


# --- Position allocation ---
# POSITION_PCT: percentage of available KRW to allocate per buy (1-100).
# MAX_ORDER_KRW: maximum KRW per buy; zero means no fixed cap.
# Set a cap when the account also holds cash unrelated to the bot.
# Example: MAX_ORDER_KRW=1000000 caps each buy at one million KRW.

POSITION_PCT=50
MAX_ORDER_KRW=0


# --- Loss limits ---
# STOP_LOSS_PCT: percentage drop from entry that triggers a sell; zero disables it.
# DAILY_LOSS_LIMIT_PCT: daily loss percentage that halts trading; zero disables it.
# A halt creates a stop file under out/.
# Review the account, remove the stop file, and restart to resume.

STOP_LOSS_PCT=5
DAILY_LOSS_LIMIT_PCT=10


# --- Market and strategy ---
# These defaults were selected from historical comparisons.
# Shorter bars increase trading frequency and may increase fee drag.

MARKET=KRW-BTC
TIMEFRAME=6h
STRATEGY=qqe_mod

# Skip buys beyond this percentage deviation from the signal price; zero disables it.
PRICE_GUARD_PCT=5


# --- Additional settings ---
# SIGNAL_MAX_AGE_MIN: maximum age of an entry signal in minutes.
# This prevents entries on stale signals after a restart.
# COOLDOWN_BARS: bars to wait after selling before buying again.
# Zero disables the cooldown.

SIGNAL_MAX_AGE_MIN=60
COOLDOWN_BARS=0


# --- Telegram notifications ---
# Unattended operation requires a way to notice failures.
# Send trade, error, and halt alerts plus a daily heartbeat.
# A missing heartbeat warrants checking the bot and notification connection.
#
# Configuration steps:
# 1. Send /newbot to BotFather and obtain the bot token.
# 2. Set TELEGRAM_TOKEN to that token.
# 3. Send a message to the bot.
# 4. Set TELEGRAM_CHAT_ID to the destination chat ID.

TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# KST hour (0-23) for the daily heartbeat.
HEARTBEAT_HOUR=9
