# Copy this file to .env and fill in your own credentials.
# Keep the example credential-free. Enable account inquiry and order permissions,
# without withdrawal permission, and register the machine IP in Upbit settings.
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=

# 1 suppresses real orders; 0 enables real trading.
DRY_RUN=1

# Percentage of available KRW per buy. MAX_ORDER_KRW=0 means no fixed cap.
POSITION_PCT=50
MAX_ORDER_KRW=0

# Percentage limits; zero disables the corresponding protection.
# A daily-loss halt requires account review and removal of the stop file in out/.
STOP_LOSS_PCT=5
DAILY_LOSS_LIMIT_PCT=10

MARKET=KRW-BTC
TIMEFRAME=6h
STRATEGY=qqe_mod

# Maximum entry-price deviation from the signal close; zero disables the guard.
PRICE_GUARD_PCT=5
# Maximum entry signal age in minutes after the bar closes.
SIGNAL_MAX_AGE_MIN=60
# Bars to wait after an exit before reentry.
COOLDOWN_BARS=0

# Optional Telegram notifications. Create a bot through BotFather and send it
# a message before configuring the target chat ID.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# Daily heartbeat hour in KST (0-23).
HEARTBEAT_HOUR=9
